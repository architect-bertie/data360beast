      "purpose": "DLO and DMO schema inspection helpers for target-org metadata discovery.",
      "upstreamPath": "skills/data360-schema-get",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-schema-get"
    },
    {
      "upstreamName": "data360-code-extension-generate",
      "beastPhase": "develop-package",
      "beastSpecialistSkill": "sf-datacloud",
      "purpose": "Data 360 code extension development, local test, scan, and deployment workflows.",
      "upstreamPath": "skills/data360-code-extension-generate",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-code-extension-generate"
    }
  ],
  "executionLoop": [
    "Think with Beast preflight, phase routing, sf-docs, OpenAPI, Beast specialists, proof ledger, and selected sf-skills companion guidance.",
    "Act with approved MCP, API, CLI, metadata, or helper tools only after org, data space, permissions, available tools, and mutation approval are clear.",
    "Prove with returned ID, status, count, data space, metadata, query result, log, event, or delivery signal.",
    "Learn by promoting only distilled public-safe evidence into Beast; keep scenario bodies and org-connected experiments in Labs."
  ],
  "weeklyWatchRules": [
    "Check only the approved companionSkills list for upstream drift.",
    "Update this contract when upstream changes affect install, routing, command behavior, templates, readiness checks, or gotchas.",
    "Do not copy upstream skill bodies into Beast.",
    "Run the installer in dry-run mode as a health check."
  ],

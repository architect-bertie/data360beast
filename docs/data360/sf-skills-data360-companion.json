{
  "schemaVersion": "1.0",
  "name": "Salesforce sf-skills Data 360 Companion Contract",
  "updated": "2026-08-01",
  "purpose": "Machine-readable contract for using the Salesforce sf-skills repository as a Data 360 execution and debugging companion to Data360 Beast without vendoring upstream skill content.",
  "upstream": {
    "repository": "https://github.com/forcedotcom/sf-skills",
    "packageName": "@salesforce/afv-skills",
    "observedPackageVersion": "1.33.0",
    "observedRef": "fe3e2edad0f763edd1927420d1d4b0e31d252452",
    "observedRefDate": "2026-08-01",
    "license": "CC-BY-NC-4.0",
    "installRoot": "skills/"
  },
  "installPolicy": {
    "scope": "data360-only",
    "mode": "subset",
    "defaultDestination": "$CODEX_HOME/skills or $HOME/.codex/skills",
    "installer": "skills/data360beast/scripts/install_sf_skills_data360_companion.py",
    "defaultCommand": "python3 skills/data360beast/scripts/install_sf_skills_data360_companion.py",
    "dryRunCommand": "python3 skills/data360beast/scripts/install_sf_skills_data360_companion.py --dry-run",
    "doNotWriteInto": [
      "VS Code Agentforce Vibes globalStorage",
      "salesforce.salesforcedx-agentforce-vibes-2/npm-afv-skills/node_modules",
      "local node_modules package folders"
    ],
    "vendoring": "Do not vendor upstream skill bodies into Data360 Beast. Fetch the selected upstream skill folders at install time."
  },
  "namingPolicy": {
    "beastFacingProductName": "Data 360",
    "upstreamExactNames": "Keep upstream folder names unchanged when installing or linking to forcedotcom/sf-skills.",
    "allowedLegacyUse": "Use Data Cloud only when quoting upstream skill names, upstream metadata, CLI/plugin compatibility text, historical source names, or user-provided text."
  },
  "authorityRules": [
    "Data360 Beast is the authority for source hierarchy, proof labels, official-doc routing, limits precedence, OpenAPI discipline, public-safe Labs promotion, and confidence.",
    "sf-docs remains the authority path for current Salesforce Help and Developer documentation.",
    "The Salesforce sf-skills companion helps plan execution and debugging paths for sf data360 command workflows.",
    "Actual org actions happen through approved CLI, MCP, API, metadata, or helper tools after Beast preflight confirms authorization.",
    "Do not treat forcedotcom/sf-skills as official Data 360 documentation.",
    "Do not treat a successful sf data360 command as proof outside its matching phase without Beast readback requirements."
  ],
  "companionSkills": [
    {
      "upstreamName": "data360-orchestrate",
      "beastPhase": "cross-phase",
      "beastSpecialistSkill": "sf-datacloud",
      "purpose": "Multi-phase setup, readiness classification, data spaces, data kits, and cross-phase troubleshooting.",
      "upstreamPath": "skills/data360-orchestrate",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-orchestrate"
    },
    {
      "upstreamName": "data360-connect",
      "beastPhase": "connect",
      "beastSpecialistSkill": "sf-datacloud-connect",
      "purpose": "Connection, connector, source discovery, connector metadata, and connection health command workflows.",
      "upstreamPath": "skills/data360-connect",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-connect"
    },
    {
      "upstreamName": "data360-prepare",
      "beastPhase": "prepare",
      "beastSpecialistSkill": "sf-datacloud-prepare",
      "purpose": "Data stream, DLO, transform, document processing, and ingestion command workflows.",
      "upstreamPath": "skills/data360-prepare",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-prepare"
    },
    {

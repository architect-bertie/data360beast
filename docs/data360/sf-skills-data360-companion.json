      "beastPhase": "harmonize",
      "beastSpecialistSkill": "sf-datacloud-harmonize",
      "purpose": "DMO, mapping, relationship, identity resolution, data graph, profile, and universal ID command workflows.",
      "upstreamPath": "skills/data360-harmonize",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-harmonize"
    },
    {
      "upstreamName": "data360-segment",
      "beastPhase": "segment",
      "beastSpecialistSkill": "sf-datacloud-segment",
      "purpose": "Segment, calculated insight, publish, count, and audience troubleshooting command workflows.",
      "upstreamPath": "skills/data360-segment",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-segment"
    },
    {
      "upstreamName": "data360-activate",
      "beastPhase": "act",
      "beastSpecialistSkill": "sf-datacloud-act",
      "purpose": "Activation, activation target, data action, data action target, and destination setup command workflows.",
      "upstreamPath": "skills/data360-activate",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-activate"
    },
    {
      "upstreamName": "data360-query",
      "beastPhase": "retrieve",
      "beastSpecialistSkill": "sf-datacloud-retrieve",
      "purpose": "Data 360 SQL, async query, table describe, search index, vector search, and hybrid search command workflows.",
      "upstreamPath": "skills/data360-query",
      "upstreamUrl": "https://github.com/forcedotcom/sf-skills/tree/main/skills/data360-query"
    },
    {
      "upstreamName": "data360-schema-get",
      "beastPhase": "retrieve",

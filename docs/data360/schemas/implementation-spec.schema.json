{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architect-bertie.github.io/data360beast/data360/schemas/implementation-spec.schema.json",
  "title": "Data360 Beast ImplementationSpec v1",
  "type": "object",
  "required": ["schemaVersion", "id", "target", "policy", "resources"],
  "properties": {
    "schemaVersion": {"const": "implementation-spec/v1"},
    "id": {"type": "string", "minLength": 1},
    "target": {"type": "object", "required": ["orgAlias", "environment"], "properties": {"orgAlias": {"type": "string"}, "environment": {"enum": ["lab", "sandbox", "production"]}, "dataSpace": {"type": "string"}}},
    "policy": {"type": "object", "required": ["productionMutationApproval"], "properties": {"productionMutationApproval": {"enum": ["required", "granted"]}}},
    "capabilityRequirements": {"type": "array"},
    "resources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "phase", "executor"], "properties": {"id": {"type": "string"}, "phase": {"type": "string"}, "executor": {"enum": ["sf-rest", "sf-data360", "metadata", "manual", "browser-lab"]}, "dependsOn": {"type": "array", "items": {"type": "string"}}, "request": {"type": "object"}}}}
  }
}

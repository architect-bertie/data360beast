{
  "schemaVersion": "1.0",
  "name": "Data360 Beast Executable Eval Fixtures",
  "description": "Deterministic text checks for prompt-level Beast evals. These checks do not replace human review or live org validation; they catch missing proof habits and known bad shortcuts.",
  "answerFileConvention": "tools/run_beast_evals.py --answers-dir eval-answers expects one Markdown or text file per eval id, such as api-payload-discipline.md.",
  "evals": [
    {
      "id": "api-payload-discipline",
      "name": "API payload discipline",
      "prompt": "Create a Data 360 segment through the API.",
      "mustMentionAny": [
        ["api version", "v6", "v65", "v66"],
        ["data space", "dataspace"],
        ["openapi", "swagger", "schema"],
        ["readback", "returned id", "segment id"],
        ["status"]
      ],
      "mustNotMention": [
        "/services/data/vXX.X/ssot/segments without schema verification",
        "create response proves the segment is healthy"
      ],
      "confidenceRequired": true
    },
    {
      "id": "data-space-handling",
      "name": "Data space handling",
      "prompt": "Run a Query SQL example in a non-default data space.",
      "mustMentionAny": [
        ["data space", "dataspace"],
        ["parameter", "token", "connection property", "ConnectApi"],
        ["target org", "metadata"],
        ["readback", "query result"]
      ],
      "mustNotMention": [
        "default data space is fine",
        "global cli state"
      ],
      "confidenceRequired": true
    },
    {
      "id": "segment-proof",
      "name": "Segment proof",
      "prompt": "My query works but segment creation fails.",
      "mustMentionAny": [
        ["query plane", "query success"],
        ["segment compiler", "DBT"],
        ["grain", "segment on"],
        ["relationship", "join path"],
        ["status", "count"]
      ],
      "mustNotMention": [
        "query success proves segment",
        "just publish it"
      ],
      "confidenceRequired": true
    },
    {
      "id": "rag-troubleshooting",
      "name": "RAG troubleshooting",
      "prompt": "The agent answers without citations.",
      "mustMentionAny": [
        ["source object", "source DMO", "source UDMO"],
        ["chunk", "index DMO"],
        ["retriever"],
        ["return fields", "citation"],
        ["prompt", "grounding"],
        ["access", "policy"]
      ],
      "mustNotMention": [
        "use a bigger model first",
        "change the prompt only"
      ],
      "confidenceRequired": true
    },
    {
      "id": "governance-proof",
      "name": "Governance proof",
      "prompt": "Who can see this DMO field?",
      "mustMentionAny": [
        ["data space"],
        ["permission set", "object access", "field access"],
        ["tag", "classification"],
        ["policy", "masking"],
        ["non-admin", "user profile"]
      ],
      "mustNotMention": [
        "system admin visibility proves",
        "metadata visibility proves"
      ],
      "confidenceRequired": true
    },
    {
      "id": "activation-proof",
      "name": "Activation proof",
      "prompt": "Publish this audience to a destination.",
      "mustMentionAny": [
        ["activation target", "target"],
        ["segment status", "segment count"],
        ["publish history", "activation status"],
        ["delivery", "destination"],
        ["readback"]
      ],
      "mustNotMention": [
        "visible segment can be activated",
        "publish button proves delivery"
      ],
      "confidenceRequired": true
    },
    {
      "id": "formula-syntax",
      "name": "Formula syntax",
      "prompt": "Add a formula field to a data stream.",
      "mustMentionAny": [
        ["formula library", "Data 360 formula"],
        ["source field label", "field label"],
        ["stream", "data stream"],
        ["check", "validate"]
      ],
      "mustNotMention": [
        "use Query SQL syntax",
        "use SOQL syntax"
      ],
      "confidenceRequired": true
    },
    {
      "id": "confidence-labeling",
      "name": "Confidence labeling",
      "prompt": "Explain this architecture to a customer.",
      "mustMentionAny": [
        ["documented"],
        ["tested"],
        ["inferred"],
        ["caveat"],
        ["next proof"]
      ],
      "mustNotMention": [
        "guaranteed by Salesforce without source",
        "contractual fact"
      ],
      "confidenceRequired": true
    },
    {
      "id": "databricks-zero-copy-networking",
      "name": "Databricks zero-copy networking",
      "prompt": "Customer wants Data 360 zero copy to Databricks but cannot whitelist Data 360 IPs.",
      "mustMentionAny": [
        ["query federation", "file federation", "accelerated query"],
        ["Private Connect for Data 360", "Salesforce Private Connect"],
        ["allowlist", "whitelist", "Data 360 IP"],
        ["Databricks", "SQL warehouse", "workspace"],
        ["Unity Catalog", "S3", "storage"],
        ["runtime", "refresh", "ongoing"],
        ["documented", "tenant proof", "current docs"]
      ],
      "mustNotMention": [
        "Salesforce Private Connect works for Data 360",
        "allowlisting is only needed for setup",
        "all Databricks zero copy modes use the same network path",
        "Databricks on AWS PrivateLink is supported without verification"
      ],
      "confidenceRequired": true
    },
    {
      "id": "runtime-target-discovery",
      "name": "Runtime target discovery",
      "prompt": "Generate a Data360 Beast implementation plan for a lab org whose local Salesforce CLI default points at a different org.",
      "mustMentionAny": [
        ["target org", "org alias"],
        ["api version", "authenticated org"],
        ["data space", "dataspace"],
        ["readback", "discovery"],
        ["capability matrix", "capability"]
      ],
      "mustNotMention": [
        "local default org is fine",
        "hard-code v66",
        "--url --json",
        "org id is safe to log"
      ],
      "confidenceRequired": true
    },
    {
      "id": "ci-control-reconciliation",
      "name": "Calculated insight control reconciliation",
      "prompt": "A calculated insight is ACTIVE and the last run says SUCCESS. Can I use it for activation?",
      "mustMentionAny": [
        ["CIO", "calculated insight output"],
        ["control query", "independent query"],
        ["row count", "aggregate"],
        ["job status", "last run"],
        ["data space"]
      ],
      "mustNotMention": [
        "ACTIVE proves output",
        "last run success is enough"
      ],
      "confidenceRequired": true
    },
    {
      "id": "segment-membership-surface",
      "name": "Segment membership surface",
      "prompt": "A segment shows 4,027 members but my membership DMO query returns zero rows.",
      "mustMentionAny": [
        ["latest", "history"],
        ["membership DMO", "membership table"],
        ["publish status"],
        ["member count"],
        ["data space"]
      ],
      "mustNotMention": [
        "segment count is enough",
        "all membership tables are equivalent"
      ],
      "confidenceRequired": true
    },
    {
      "id": "code-extension-remote-proof",
      "name": "Code Extension remote proof",
      "prompt": "My Data 360 Code Extension script passes local run and deploy says success. Is the feature proven?",
      "mustMentionAny": [
        ["target org", "org alias"],
        ["data space", "dataspace"],
        ["DataCustomCode", "deployment readback"],
        ["batch transform", "run history", "terminal run"],
        ["output", "control query", "independent reconciliation"],
        ["DataCustomCodeLogs__dll", "logs", "10 minutes"],
        ["schedule endpoint", "schedule readback", "unscheduled"]
      ],
      "mustNotMention": [
        "local run proves remote execution",
        "deploy success proves output",
        "empty logs mean no observability",
        "FullRunFrequency proves the schedule"
      ],
      "confidenceRequired": true
    },
    {
      "id": "query-consumer-compatibility",
      "name": "Query consumer compatibility",
      "prompt": "Can I use DBeaver, Looker, Power BI, or Jupyter to query Data 360?",
      "mustMentionAny": [
        ["consumer", "tool", "client"],
        ["interface", "driver", "connector", "jdbc", "odbc", "python", "rest"],
        ["auth", "oauth", "jwt", "external client app"],
        ["read-only", "query", "retrieve", "read"],
        ["compute", "locality", "runs", "remote", "local"],
        ["documented", "interface-compatible", "tenant-tested", "candidate", "inferred"],
        ["next proof", "readback", "result rows", "data space"]
      ],
      "mustNotMention": [
        "Looker is certified for Data 360",
        "all JDBC tools are certified",
        "Power BI proves XMLA ingestion works",
        "Jupyter means the transform runs locally"
      ],
      "confidenceRequired": true
    },
    {
      "id": "client-engine-separation",
      "name": "Client and engine separation",
      "prompt": "Which engine does DBeaver, Looker, Power BI, Tableau, or Jupyter use against Data 360?",
      "mustMentionAny": [
        ["consumer", "tool", "client"],
        ["api", "query-sql", "direct api", "jdbc", "odbc", "python"],
        ["engine", "hyper", "trino", "spark"],
        ["infer", "inferred", "not infer", "do not infer"],
        ["proof", "readback", "documented", "tenant"]
      ],
      "mustNotMention": [
        "DBeaver uses Spark",
        "Looker uses Hyper",
        "Power BI uses Trino",
        "Jupyter uses Spark because it is Python",
        "client name proves the engine"
      ],
      "confidenceRequired": true
    },
    {
      "id": "python-connector-vs-code-extension",
      "name": "Python connector versus Code Extension",
      "prompt": "Why upload Code Extension if Python can query Data 360 from a notebook?",
      "mustMentionAny": [
        ["python connector", "jupyter", "notebook"],
        ["query", "extract", "pandas", "dataframe"],
        ["code extension", "custom script", "batch transform"],
        ["managed", "remote", "data 360 execution"],
        ["deployment", "package", "upload"],
        ["schedule", "security", "observability", "logs", "output ownership"],
        ["spark", "dataframe"]
      ],
      "mustNotMention": [
        "upload is required only because Spark",
        "Python connector proves Code Extension",
        "notebook execution is remote transform proof",
        "local dataframe output proves Data 360 output"
      ],
      "confidenceRequired": true
    },
    {
      "id": "powerbi-xmla-direction",
      "name": "Power BI XMLA direction",
      "prompt": "Is Power BI XMLA the same as the Power BI Desktop Connector for Data 360?",
      "mustMentionAny": [
        ["power bi desktop connector", "desktop"],
        ["xmla"],
        ["data in", "ingest", "federate", "inbound"],
        ["directquery", "import", "outbound", "query consumer"],
        ["direction", "workload"],
        ["documented", "proof", "data space"]
      ],
      "mustNotMention": [
        "Power BI XMLA is the Power BI Desktop Connector",
        "XMLA is outbound Data 360 querying",
        "DirectQuery uses XMLA connector",
        "Power BI Desktop ingestion connector"
      ],
      "confidenceRequired": true
    }
  ]
}
